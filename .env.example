# Copia este archivo como .env.local y llena los valores.
# NUNCA subas .env.local al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (webhook de ingesta, Fase 2). Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Fase 2: secreto maestro para firmar las alertas (mínimo 32 caracteres; ej. openssl rand -base64 48).
# De él se deriva una clave distinta para cada uno, que se ve en Ajustes → Conectar mi Gmail.
INGEST_HMAC_SECRET=cambia-esto-por-un-secreto-largo-de-minimo-32-caracteres

# Fase 4: llaves VAPID para notificaciones push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
